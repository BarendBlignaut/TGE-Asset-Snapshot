{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tge-asset-snapshot",
  "main": "src/index.js",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tge-asset-snapshot-db",
      "database_id": "c816090b-24c2-4ee0-8765-dce000b1d83d"
    }
  ],
  "triggers": {
    "crons": ["0 20 * * *"]
  }
}
